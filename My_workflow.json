    {
      "parameters": {
        "jsCode": "// n8n Code Node - Run Once for All Items\nconst results = [];\nfor (const item of $input.all()) {\n  const rawOutput = item.json.output;\n  let parsed;\n  try {\n    parsed = JSON.parse(rawOutput);\n  } catch (error) {\n    // Fallback in case output isn't valid JSON for some reason\n    parsed = {\n      q1_score: 0,\n      q2_score: 0,\n      q3_score: 0,\n      q4_score: 0,\n      q5_score: 0,\n      total_score: 0,\n      result: \"FAIL\",\n      feedback: \"Could not parse grading result.\"\n    };\n  }\n  const studentData = $('Responses (new)').item.json;\n  results.push({\n    json: {\n      StudentName: studentData['Name'],\n      Email: studentData['Email'],\n      q1_score: parsed.q1_score,\n      q2_score: parsed.q2_score,\n      q3_score: parsed.q3_score,\n      q4_score: parsed.q4_score,\n      q5_score: parsed.q5_score,\n      total_score: parsed.total_score,\n      result: parsed.result,\n      feedback: parsed.feedback\n    }\n  });\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
