    {
      "parameters": {
        "jsCode": "// n8n Code Node - Run Once for All Items\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Parse date - supports \"DD-MM-YYYY\" or \"DD-MM-YY\"\n  const dateStr = data.Date;\n  const parts = dateStr.split(\"-\");\n\n  let day = parseInt(parts[0], 10);\n  let month = parseInt(parts[1], 10) - 1; // JS months are 0-indexed\n  let year = parseInt(parts[2], 10);\n\n  // Handle 2-digit year (e.g. \"26\" -> 2026)\n  if (year < 100) {\n    year += 2000;\n  }\n\n  const enrollmentDate = new Date(year, month, day);\n  const today = new Date();\n\n  // Calculate days elapsed\n  const diffTime = today.getTime() - enrollmentDate.getTime();\n  const daysElapsed = Math.floor(diffTime / (1000 * 60 * 60 * 24));\n\n  const isEligible = daysElapsed >= 30;\n  const eligibility = isEligible ? \"eligible\" : \"ineligible\";\n\n  let reason;\n  if (isEligible) {\n    reason = `Day ${daysElapsed} - 30 day period completed`;\n  } else {\n    const remainingDays = 30 - daysElapsed;\n    reason = `Day ${daysElapsed} - ${remainingDays} day(s) remaining`;\n  }\n\n  results.push({\n    json: {\n      ...data,\n      daysElapsed: daysElapsed,\n      enrollmentDate: enrollmentDate.toDateString(),\n      eligibility: eligibility,\n      reason: reason\n    }\n  });\n}\n\nreturn results;"
      },
