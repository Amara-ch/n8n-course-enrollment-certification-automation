      "parameters": {
        "jsCode": "// n8n Code Node - Run Once for All Items\n// Generates a professional HTML email body for exam results\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  const studentName = data['Student name'] || data['Name'] || 'Student';\n  const isPass = data.result === 'PASS';\n\n  const statusColor = isPass ? '#059669' : '#DC2626';\n  const statusBg = isPass ? '#ECFDF5' : '#FEF2F2';\n  const statusBorder = isPass ? '#A7F3D0' : '#FECACA';\n  const statusText = isPass ? 'PASS' : 'FAIL';\n  const headerMsg = isPass ? 'Congratulations! You Passed 🎉' : 'Exam Result';\n\n  const htmlBody = `\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0; padding:0; background-color:#eef0f4; font-family: 'Segoe UI', Arial, sans-serif;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eef0f4; padding:50px 0;\">\n    <tr>\n      <td align=\"center\">\n\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 6px 24px rgba(17,17,17,0.08);\">\n\n          <tr>\n            <td style=\"background-color:#111827; padding:40px 30px; text-align:center;\">\n              <p style=\"color:#9CA3AF; font-size:12px; letter-spacing:2px; text-transform:uppercase; margin:0 0 12px; font-weight:600;\">\n                n8n Course of Automation\n              </p>\n              <h1 style=\"color:#ffffff; font-size:26px; margin:0; font-weight:700;\">\n                ${headerMsg}\n              </h1>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:35px 40px 10px;\">\n              <p style=\"font-size:16px; color:#111827; margin:0 0 20px;\">\n                Hi <strong>${studentName}</strong>,\n              </p>\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 20px;\">\n                Your certification exam has been graded. Here are your detailed results:\n              </p>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:0 40px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:${statusBg}; border:1px solid ${statusBorder}; border-radius:10px; padding:25px; text-align:center;\">\n                <tr>\n                  <td>\n                    <p style=\"font-size:13px; color:${statusColor}; margin:0 0 6px; text-transform:uppercase; letter-spacing:1px; font-weight:700;\">\n                      Result\n                    </p>\n                    <p style=\"font-size:34px; color:${statusColor}; margin:0; font-weight:800;\">\n                      ${statusText}\n                    </p>\n                    <p style=\"font-size:15px; color:#374151; margin:10px 0 0; font-weight:600;\">\n                      Total Score: ${data.total_score} / 25\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:30px 40px 5px;\">\n              <p style=\"font-size:15px; color:#111827; margin:0 0 15px; font-weight:600;\">\n                Question-wise Breakdown:\n              </p>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n                <tr style=\"background-color:#F9FAFB;\">\n                  <td style=\"padding:10px 12px; font-size:14px; color:#374151; border:1px solid #E5E7EB;\">Q1 - Webhook vs Polling Trigger</td>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#111827; border:1px solid #E5E7EB; text-align:center; font-weight:600;\">${data.q1_score} / 5</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#374151; border:1px solid #E5E7EB;\">Q2 - Merge Node</td>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#111827; border:1px solid #E5E7EB; text-align:center; font-weight:600;\">${data.q2_score} / 5</td>\n                </tr>\n                <tr style=\"background-color:#F9FAFB;\">\n                  <td style=\"padding:10px 12px; font-size:14px; color:#374151; border:1px solid #E5E7EB;\">Q3 - Data Pinning</td>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#111827; border:1px solid #E5E7EB; text-align:center; font-weight:600;\">${data.q3_score} / 5</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#374151; border:1px solid #E5E7EB;\">Q4 - On Error Handling</td>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#111827; border:1px solid #E5E7EB; text-align:center; font-weight:600;\">${data.q4_score} / 5</td>\n                </tr>\n                <tr style=\"background-color:#F9FAFB;\">\n                  <td style=\"padding:10px 12px; font-size:14px; color:#374151; border:1px solid #E5E7EB;\">Q5 - Expressions in n8n</td>\n                  <td style=\"padding:10px 12px; font-size:14px; color:#111827; border:1px solid #E5E7EB; text-align:center; font-weight:600;\">${data.q5_score} / 5</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:30px 40px 10px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F9FAFB; border:1px solid #E5E7EB; border-radius:10px; padding:22px;\">\n                <tr>\n                  <td>\n                    <p style=\"font-size:13px; color:#6B7280; margin:0 0 8px; text-transform:uppercase; letter-spacing:1px; font-weight:700;\">\n                      Feedback\n                    </p>\n                    <p style=\"font-size:14px; color:#374151; margin:0; line-height:1.7;\">\n                      ${data.feedback}\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:30px 40px 10px;\">\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 18px;\">\n                ${isPass\n                  ? 'Congratulations on passing your certification exam! Your certificate will be issued and sent to you shortly.'\n                  : 'Unfortunately, you did not meet the passing criteria this time. Please review the course material and reach out in the WhatsApp group if you would like guidance on reattempting the exam.'}\n              </p>\n              <p style=\"font-size:15px; color:#111827; margin:20px 0 0; font-weight:600;\">\n                ${isPass ? 'Well done, and happy automating! 🚀' : 'Keep learning, and best of luck next time!'}\n              </p>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:35px 40px; border-top:1px solid #E5E7EB; text-align:center;\">\n              <p style=\"font-size:14px; color:#111827; margin:0; font-weight:600;\">\n                Warm regards\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n        <p style=\"font-size:12px; color:#9CA3AF; margin-top:22px;\">\n          This is an automated result email for the n8n Course of Automation.\n        </p>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>\n  `;\n\n  results.push({\n    json: {\n      ...data,\n      studentName: studentName,\n      emailSubject: isPass\n        ? `🎉 Congratulations! You Passed the n8n Certification Exam`\n        : `Your n8n Certification Exam Result`,\n      emailHtmlBody: htmlBody\n    }\n  });\n}\n\nreturn results;"
      },
