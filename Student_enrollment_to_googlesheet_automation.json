    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Your n8n Course Enrollment Is Confirmed!",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Welcome Email</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#eef0f4; font-family: 'Segoe UI', Arial, sans-serif;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eef0f4; padding:50px 0;\">\n    <tr>\n      <td align=\"center\">\n\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 6px 24px rgba(17,17,17,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#111827; padding:45px 30px; text-align:center;\">\n              <p style=\"color:#9CA3AF; font-size:12px; letter-spacing:2px; text-transform:uppercase; margin:0 0 12px; font-weight:600;\">\n                Enrollment Confirmed\n              </p>\n              <h1 style=\"color:#ffffff; font-size:28px; margin:0; font-weight:700; letter-spacing:-0.3px;\">\n                Welcome to the n8n Course of Automation\n              </h1>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:40px 40px 15px;\">\n              <p style=\"font-size:16px; color:#111827; margin:0 0 20px;\">\n                Hi <strong>{{ $json.Name }}</strong>,\n              </p>\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 18px;\">\n                Congratulations, and welcome! We're delighted to have you join the\n                <strong style=\"color:#111827;\">n8n Course of Automation</strong>. Enrolling is a\n                great step forward, and we're glad you're taking it with us.\n              </p>\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 25px;\">\n                You are now officially part of our learning community, and our team is here to\n                support you at every stage of this journey.\n              </p>\n            </td>\n          </tr>\n\n          <!-- WhatsApp Card -->\n          <tr>\n            <td style=\"padding:0 40px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#F9FAFB; border:1px solid #E5E7EB; border-radius:10px; padding:28px; text-align:center;\">\n                <tr>\n                  <td>\n                    <p style=\"font-size:15px; color:#111827; margin:0 0 20px; font-weight:600;\">\n                      Join Your Course Community Group\n                    </p>\n                    <a href=\"https://chat.whatsapp.com/C5ksQ7Llj604oXUh9Uhao1\" target=\"_blank\"\n                       style=\"background-color:#111827; color:#ffffff; text-decoration:none; font-size:15px; font-weight:600; padding:14px 40px; border-radius:8px; display:inline-block;\">\n                      Join WhatsApp Group\n                    </a>\n                    <p style=\"font-size:13px; color:#6B7280; margin:18px 0 0; line-height:1.6;\">\n                      All future announcements, resources, and updates will be shared here first.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Info Note -->\n          <tr>\n            <td style=\"padding:30px 40px 10px;\">\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 18px;\">\n                <strong style=\"color:#111827;\">Please note:</strong> your 30-day learning period\n                officially begins from your date of enrollment. We'd encourage you to get started\n                as soon as possible to make the most of your access.\n              </p>\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 18px;\">\n                We believe in your ability to learn, grow, and succeed, and we look forward to\n                supporting you throughout this experience.\n              </p>\n              <p style=\"font-size:15px; color:#111827; margin:25px 0 0; font-weight:600;\">\n                Welcome once again, and happy learning.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:35px 40px; border-top:1px solid #E5E7EB; text-align:center;\">\n              <p style=\"font-size:14px; color:#111827; margin:0; font-weight:600;\">\n                Warm regards\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n        <p style=\"font-size:12px; color:#9CA3AF; margin-top:22px;\">\n          This email was sent because you enrolled in the n8n Course of Automation.\n        </p>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
