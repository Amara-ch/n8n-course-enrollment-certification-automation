    {
      "parameters": {
        "sendTo": "={{ $('On form submission').item.json.Email }}",
        "subject": "Reminder of Exam of Certification",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Exam Reminder</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#eef0f4; font-family: 'Segoe UI', Arial, sans-serif;\">\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eef0f4; padding:50px 0;\">\n    <tr>\n      <td align=\"center\">\n\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 6px 24px rgba(17,17,17,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background-color:#B45309; padding:40px 30px; text-align:center;\">\n              <p style=\"color:#FDE9C9; font-size:12px; letter-spacing:2px; text-transform:uppercase; margin:0 0 12px; font-weight:600;\">\n                Reminder\n              </p>\n              <h1 style=\"color:#ffffff; font-size:26px; margin:0; font-weight:700; letter-spacing:-0.3px;\">\n                Your Certification Exam is Coming Up\n              </h1>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:40px 40px 10px;\">\n              <p style=\"font-size:16px; color:#111827; margin:0 0 20px;\">\n                Hi <strong>{{$('On form submission').item.json.Name }}</strong>,\n              </p>\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 20px;\">\n                This is a quick reminder that your <strong style=\"color:#111827;\">n8n Course of Automation</strong>\n                certification exam is just around the corner. You're now on\n                <strong style=\"color:#111827;\">Day 25 of your 30-day learning period</strong> —\n                only 5 days remain before your exam window closes.\n              </p>\n            </td>\n          </tr>\n\n          <!-- Countdown / Highlight Card -->\n          <tr>\n            <td style=\"padding:0 40px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#FFFBEB; border:1px solid #FDE68A; border-radius:10px; padding:26px; text-align:center;\">\n                <tr>\n                  <td>\n                    <p style=\"font-size:13px; color:#92400E; margin:0 0 6px; text-transform:uppercase; letter-spacing:1px; font-weight:700;\">\n                      Days Remaining\n                    </p>\n                    <p style=\"font-size:38px; color:#B45309; margin:0; font-weight:800;\">\n                      5 Days\n                    </p>\n                    <p style=\"font-size:13px; color:#92400E; margin:8px 0 0;\">\n                      Exam access closes at the end of Day 30\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Checklist -->\n          <tr>\n            <td style=\"padding:30px 40px 5px;\">\n              <p style=\"font-size:15px; color:#111827; margin:0 0 15px; font-weight:600;\">\n                Before your exam, make sure to:\n              </p>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"padding:6px 0; font-size:14px; color:#4B5563; line-height:1.7;\">\n                    ✅ Complete all remaining course lessons\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; font-size:14px; color:#4B5563; line-height:1.7;\">\n                    ✅ Revise key workflow-building and automation concepts\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; font-size:14px; color:#4B5563; line-height:1.7;\">\n                    ✅ Practice building at least one end-to-end n8n workflow\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:6px 0; font-size:14px; color:#4B5563; line-height:1.7;\">\n                    ✅ Post any questions in the WhatsApp group before the deadline\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- CTA Button -->\n          <tr>\n            <td style=\"padding:30px 40px; text-align:center;\">\n              <a href=\"https://chat.whatsapp.com/C5ksQ7Llj604oXUh9Uhao1\" target=\"_blank\"\n                 style=\"background-color:#111827; color:#ffffff; text-decoration:none; font-size:15px; font-weight:600; padding:14px 40px; border-radius:8px; display:inline-block;\">\n                Ask a Question in the Group\n              </a>\n            </td>\n          </tr>\n\n          <!-- Closing -->\n          <tr>\n            <td style=\"padding:0 40px 10px;\">\n              <p style=\"font-size:15px; color:#4B5563; line-height:1.8; margin:0 0 18px;\">\n                You've put in solid effort so far — a little revision now will make all the\n                difference on exam day. We're rooting for you!\n              </p>\n              <p style=\"font-size:15px; color:#111827; margin:20px 0 0; font-weight:600;\">\n                All the best for your certification exam. 🚀\n              </p>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:35px 40px; border-top:1px solid #E5E7EB; text-align:center;\">\n              <p style=\"font-size:14px; color:#111827; margin:0; font-weight:600;\">\n                Warm regards\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n        <p style=\"font-size:12px; color:#9CA3AF; margin-top:22px;\">\n          This reminder was sent because you enrolled in the n8n Course of Automation.\n        </p>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
